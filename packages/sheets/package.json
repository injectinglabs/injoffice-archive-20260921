{
  "name": "@injoffice/sheets",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Injecting Inc.",
  "description": "Renderer-neutral native XLSX import, projection, and fail-closed spreadsheet mutation contracts.",
  "engines": { "node": ">=22" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injectinglabs/injoffice.git",
    "directory": "packages/sheets"
  },
  "homepage": "https://github.com/injectinglabs/injoffice#readme",
  "bugs": { "url": "https://github.com/injectinglabs/injoffice/issues" },
  "injoffice": {
    "entries": { "index": "src/index.ts", "browser": "src/browser.ts" }
  },
  "scripts": {
    "prebuild": "npm run build -w @injoffice/font-metrics",
    "build": "node ../../scripts/build-package.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/generate-xlsx-native-contract.mjs --check && vitest run"
  },
  "dependencies": {
    "@injoffice/font-metrics": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "dejavu-fonts-ttf": "2.37.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  }
}
