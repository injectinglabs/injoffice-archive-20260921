{
  "name": "@injoffice/xlsx-exchange",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Injecting Inc.",
  "description": "Host-neutral XLSX snapshot and server-unit import/export job lifecycle.",
  "engines": { "node": ">=22" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injectinglabs/injoffice.git",
    "directory": "packages/xlsx-exchange"
  },
  "homepage": "https://github.com/injectinglabs/injoffice#readme",
  "bugs": { "url": "https://github.com/injectinglabs/injoffice/issues" },
  "scripts": {
    "prebuild": "npm run build -w @injoffice/sheets",
    "build": "node ../../scripts/build-package.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "pretypecheck": "npm run build -w @injoffice/sheets",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @injoffice/sheets",
    "test": "vitest run"
  },
  "dependencies": {
    "@injoffice/sheets": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  }
}
