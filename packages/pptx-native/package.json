{
  "name": "@injoffice/pptx-native",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Injecting Inc.",
  "description": "Versioned native PPTX JSON contract shared by InjOffice parsers, patchers, and renderers.",
  "engines": { "node": ">=22" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injectinglabs/injoffice.git",
    "directory": "packages/pptx-native"
  },
  "homepage": "https://github.com/injectinglabs/injoffice#readme",
  "bugs": { "url": "https://github.com/injectinglabs/injoffice/issues" },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/generate-pptx-native-contract.mjs --check && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  }
}
