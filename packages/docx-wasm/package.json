{
  "name": "@injoffice/docx-wasm",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Injecting Inc.",
  "description": "Browser worker distribution of the fail-closed InjOffice DOCX Go engine.",
  "engines": { "node": ">=22" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injectinglabs/injoffice.git",
    "directory": "packages/docx-wasm"
  },
  "homepage": "https://github.com/injectinglabs/injoffice#readme",
  "bugs": { "url": "https://github.com/injectinglabs/injoffice/issues" },
  "injoffice": {
    "assets": ["docxnative.worker.js", "docxnative.wasm", "wasm_exec.js"],
    "tscOnly": true,
    "legalFiles": ["NOTICE"]
  },
  "scripts": {
    "prebuild": "npm run build -w @injoffice/native-runtime -w @injoffice/docs",
    "build": "node ../../scripts/build-package.mjs && tsc -p tsconfig.build.json && ../../go/docxpatch/cmd/docxnativewasm/build.sh $PWD/dist && cp worker/docxnative.worker.js dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@injoffice/docs": "0.1.0",
    "@injoffice/native-runtime": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  }
}
